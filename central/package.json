{
  "name": "@unstale/central",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Central pipeline: collects upstream docs, release notes and pricing, and detects changes.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collect": "tsx src/collector/cli.ts",
    "replay:node": "tsx scripts/replay-node.ts",
    "gen:schema": "cargo run -q --manifest-path ../local/Cargo.toml --bin gen-schema && tsx scripts/gen-zod.ts",
    "check:schema": "cargo run -q --manifest-path ../local/Cargo.toml --bin gen-schema -- --check && tsx scripts/gen-zod.ts --check",
    "pipeline": "tsx src/pipeline/cli.ts pipeline",
    "catalog": "tsx src/pipeline/cli.ts",
    "serve": "tsx src/onboarding/cli.ts",
    "drain": "tsx src/onboarding/drain.ts",
    "docs": "tsx src/docs/cli.ts"
  },
  "dependencies": {
    "css-select": "7.0.0",
    "diff": "9.0.0",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
