--- /dev/null
+++ b/central/test/extract-shared-guide.test.ts
@@ -0,0 +1,156 @@
+// A shared upgrade guide (eval/select/slice6): the packages of a family read one guide page; the extract and label
+// prompts name the guide, not the package, so the second package's extraction is a cache hit, and one selection call
+// per package keeps the records that concern it. The model is a stubbed chat-completions endpoint; llm.ts is real.
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+import { extractLlm } from "../src/pipeline/llm.ts";
+import { extractRelease, guideSubject, releaseCached } from "../src/pipeline/extract.ts";
+import { recordState } from "../src/pipeline/classify/labels.ts";
+import { ClassifierCache, FallbackClassifier, type Classifier } from "../src/pipeline/classify/adapter.ts";
+import type { GuideNote } from "../src/pipeline/fetch.ts";
+import type { Technology } from "../src/pipeline/technologies.ts";
+
+const prev = { ...process.env };
+const OWN = ["UNSTALE_CENTRAL_DIR", "AI_GATEWAY_API_KEY", "UNSTALE_EXTRACT_MODEL", "UNSTALE_EXTRACT_STRUCTURE", "UNSTALE_EXTRACT_EVIDENCE", "UNSTALE_EXTRACT_DIET", "UNSTALE_GUIDE_SHARED"];
+beforeEach(() => {
+  for (const k of OWN) delete process.env[k];
+  process.env.UNSTALE_CENTRAL_DIR = mkdtempSync(join(tmpdir(), "unstale-shared-guide-"));
+  process.env.AI_GATEWAY_API_KEY = "test-key";
+  process.env.UNSTALE_EXTRACT_MODEL = "vercel:openai/gpt-6-luna";
+});
+afterAll(() => {
+  for (const k of OWN) {
+    if (prev[k] === undefined) delete process.env[k];
+    else process.env[k] = prev[k];
+  }
+});
+afterEach(() => vi.unstubAllGlobals());
+
+const reply = (content: string) =>
+  new Response(JSON.stringify({ choices: [{ message: { content }, finish_reason: "stop" }], usage: { prompt_tokens: 10, completion_tokens: 5 } }), { status: 200 });
+
+const tech = (id: string, name: string): Technology => ({ id, name, repo: "vercel/ai", components: [`pkg:npm/${name.replace("@", "%40")}`], tag: /^$/, clean: (b) => b });
+const core = tech("ai", "ai");
+const openai = tech("ai-sdk-openai", "@ai-sdk/openai");
+const guide = (date: string): GuideNote => ({
+  technology: "x",
+  kind: "upgrade_guide",
+  tag: "guide-7",
+  version: "7.0.0",
+  date,
+  url: "https://ai-sdk.dev/docs/migration-guides/migration-guide-7-0",
+  snapshot: "sha256:ed1b1648",
+  keyTag: "+guide.ed1b1648",
+  notes: "## Core\n- `generateText` now returns `output`.\n## OpenAI provider\n- `openai.chat` is removed; use `openai`.",
+});
+const RECORDS = JSON.stringify([
+  { subject: "generateText", summary: "generateText now returns output.", evidence: "`generateText` now returns `output`." },
+  { subject: "openai.chat", summary: "openai.chat is removed.", evidence: "`openai.chat` is removed; use `openai`." },
+]);
+
+/** The stub model: extraction, labels, and a selection that keeps r1 for `ai` and both records for the provider. */
+function model() {
+  const prompts: string[] = [];
+  const f = vi.fn(async (_url: string, init: RequestInit) => {
+    const prompt = (JSON.parse(String(init.body)) as { messages: Array<{ content: string }> }).messages[0]!.content;
+    prompts.push(prompt);
+    if (prompt.startsWith("You decide which change records")) return reply(prompt.includes("Package: ai (") ? '["r1"]' : '["r1", "r2"]');
+    if (prompt.startsWith("You write search terms")) return reply('{"r1": {"terms": ["generateText"]}, "r2": {"terms": ["openai.chat"]}}');
+    return reply(RECORDS);
+  });
+  vi.stubGlobal("fetch", f);
+  return { f, prompts };
+}
+
+describe("shared upgrade guides", () => {
+  test("the guide is extracted and labelled once for the family; each package keeps its own selection", async () => {
+    const { prompts } = model();
+    const a = await extractRelease(core, guide("2026-06-25"));
+    expect(releaseCached(openai, guide("2026-10-20"))).toBe(true);
+    const b = await extractRelease(openai, guide("2026-10-20"));
+    const kinds = prompts.map((p) => p.split("\n")[0]!.slice(0, 30));
+    expect(kinds.filter((k) => k.startsWith("You extract"))).toHaveLength(1);
+    expect(kinds.filter((k) => k.startsWith("You write"))).toHaveLength(1);
+    expect(kinds.filter((k) => k.startsWith("You decide"))).toHaveLength(2);
+    // The shared prompts name the guide, not a package, and carry no package's date.
+    const extract = prompts.find((p) => p.startsWith("You extract"))!;
+    expect(extract).toContain(`Technology: ${guideSubject(guide("x").url)}`);
+    expect(extract).toContain("Release: 7.0.0 (upgrade guide)");
+    expect(a.failed + b.failed).toBe(0);
+    expect(a.incoming.map((i) => [i.key, i.subject])).toEqual([["ai@7.0.0+guide.ed1b1648#0.0", "generateText"]]);
+    expect(b.incoming.map((i) => i.key)).toEqual(["ai-sdk-openai@7.0.0+guide.ed1b1648#0.0", "ai-sdk-openai@7.0.0+guide.ed1b1648#0.1"]);
+    expect(b.incoming[1]!.terms).toEqual(["openai.chat"]);
+    expect(b.incoming.every((i) => i.kind === "upgrade_guide" && i.date === "2026-10-20")).toBe(true);
+    // The selection names the package and lists the guide's records by id.
+    const sel = prompts.filter((p) => p.startsWith("You decide")).at(-1)!;
+    expect(sel).toContain("Package: @ai-sdk/openai (pkg:npm/@ai-sdk/openai)");
+    expect(sel).toContain('"id": "r2"');
+  });
+
+  test("UNSTALE_GUIDE_SHARED=0 restores the per-package prompts: no selection, one extraction per package", async () => {
+    process.env.UNSTALE_GUIDE_SHARED = "0";
+    const { prompts } = model();
+    await extractRelease(core, guide("2026-06-25"));
+    const b = await extractRelease(openai, guide("2026-10-20"));
+    expect(prompts.filter((p) => p.startsWith("You extract"))).toHaveLength(2);
+    expect(prompts.some((p) => p.startsWith("You decide"))).toBe(false);
+    expect(prompts.find((p) => p.startsWith("You extract"))).toContain("Technology: ai\nRelease: 7.0.0 (2026-06-25)");
+    expect(b.incoming).toHaveLength(2);
+  });
+
+  test("a failed selection keeps nothing and counts as a failed call", async () => {
+    const f = vi.fn(async (_url: string, init: RequestInit) => {
+      const prompt = (JSON.parse(String(init.body)) as { messages: Array<{ content: string }> }).messages[0]!.content;
+      if (prompt.startsWith("You decide")) return reply("no idea");
+      if (prompt.startsWith("You write")) return reply("{}");
+      return reply(RECORDS);
+    });
+    vi.stubGlobal("fetch", f);
+    vi.useFakeTimers({ toFake: ["setTimeout"] });
+    try {
+      const p = extractRelease(openai, guide("2026-10-20"));
+      await vi.runAllTimersAsync();
+      expect(await p).toEqual({ incoming: [], failed: 1 });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  test("the classifier's state names the guide for guide records and the package otherwise", async () => {
+    model();
+    const [inc] = (await extractRelease(openai, guide("2026-10-20"))).incoming;
+    expect(recordState("@ai-sdk/openai", inc!).technology).toBe(guideSubject(inc!.url));
+    expect(recordState("@ai-sdk/openai", { ...inc!, kind: "release_notes" }).technology).toBe("@ai-sdk/openai");
+    process.env.UNSTALE_GUIDE_SHARED = "0";
+    expect(recordState("@ai-sdk/openai", inc!).technology).toBe("@ai-sdk/openai");
+  });
+});
+
+describe("requests already in flight", () => {
+  test("the same model request made twice at once is sent once", async () => {
+    const { f } = model();
+    const [x, y] = await Promise.all([extractLlm("Say [] please", (t) => JSON.parse(t) as unknown), extractLlm("Say [] please", (t) => JSON.parse(t) as unknown)]);
+    expect(x).toEqual(y);
+    expect(f).toHaveBeenCalledTimes(1);
+  });
+
+  test("the same classifier request made twice at once is asked once", async () => {
+    let calls = 0;
+    const primary: Classifier = {
+      name: "jev",
+      model: "jev-test",
+      classify: async () => {
+        calls++;
+        await new Promise((r) => setTimeout(r, 5));
+        return { classifier: "jev", model: "jev-test", answers: {} } as never;
+      },
+    };
+    const fallback: Classifier = { name: "chat", model: "chat-test", classify: async () => ({}) as never };
+    const cls = new FallbackClassifier(primary, fallback, new ClassifierCache(join(process.env.UNSTALE_CENTRAL_DIR!, "cls")));
+    const state = { technology: "x" };
+    await Promise.all([cls.classify(state, {}), cls.classify(state, {})]);
+    expect(calls).toBe(1);
+  });
+});
