// Fixtures for the client's port of central's extraction (local/cli/src/pipeline/), generated by central's own
// TypeScript: what `chunk`, `splitChunk`, `contentFree` and `locate` return (cut in UTF-16 code units, as JavaScript
// counts), and whole extractions of change events (`eventOf`) through `extractRelease` against a stubbed model: every
// request body sent, the answer given to each, and the records that came out. The Rust tests replay the answers and
// must send the same prompts and build the same records.
//
// Regenerate (no network, no model call):
//   cd central && npx tsx ../local/cli/tests/fixtures/js-port/generate.mts
import { mkdtempSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

for (const k of ["UNSTALE_EXTRACT_MODEL", "UNSTALE_EXTRACT_EFFORT", "UNSTALE_EXTRACT_SERVICE_TIER", "UNSTALE_EXTRACT_STRUCTURE", "UNSTALE_EXTRACT_EVIDENCE", "UNSTALE_EXTRACT_DIET"]) delete process.env[k];
process.env.UNSTALE_EXTRACT_MODEL = "vercel:openai/gpt-6-luna";
process.env.AI_GATEWAY_API_KEY = "fixture-key";
process.env.UNSTALE_CENTRAL_DIR = mkdtempSync(join(tmpdir(), "unstale-js-port-"));

const { chunk, contentFree, extractRelease, locate, splitChunk, MIN_SPLIT } = await import("../../../../../central/src/pipeline/extract.ts");
const { eventOf } = await import("../../../../../central/src/pipeline/events.ts");
const { renderChange } = await import("../../../../../central/src/docs/render.ts");
const { sha256 } = await import("../../../../../central/src/pipeline/util.ts");

// ---- Text functions. Lines mix ASCII, accented Latin, CJK and emoji (two UTF-16 units each), so a port counting
// bytes or chars cuts elsewhere. No case cuts inside a surrogate pair (JavaScript would leave a lone half).
const emojiLine = (i: number) => `- 修复 \`route${i}\` 🚀 handling of trailing slashes — café ✨ ${"é".repeat(i % 7)}`;
const mixed = Array.from({ length: 160 }, (_, i) => (i % 37 === 0 ? `## Section ${i} 🎉` : emojiLine(i))).join("\n");
const longLine = "Ünïcödé ".repeat(4000).trim();
const chunkCases = [
  { notes: mixed, max: 9_000 },
  { notes: mixed, max: 4_000 },
  { notes: mixed, max: 1_234 },
  { notes: `## Intro\n${longLine}\n## Next\n- done`, max: 30_000 },
  { notes: `## Intro\n${longLine}\n## Next\n- done`, max: 10_000 },
  { notes: `${"x".repeat(50)}\n${"y".repeat(10)}`, max: 50 },
  { notes: "short 🎉", max: 30_000 },
];
const docsLong = renderChange(
  "https://example.dev/docs/config",
  "docs",
  Array.from({ length: 30 }, (_, i) => ({
    path: ["Config", `option${i} ✨`],
    status: "changed" as const,
    hunks: `@@ -1,3 +1,3 @@\n The option ${i} — ünïcödé.\n-Default: ${i} seconds.\n+Default: ${i * 2} seconds 🚀.\n More text about option ${i} that is long enough to matter for the split.`,
    added: 1,
    removed: 1,
  })),
);
const splitCases = [mixed, mixed.slice(0, 3_001), docsLong, `## A\n${"- é item\n".repeat(400)}`];
const contentFreeCases = [
  "## v1.2.3\n\n**Full Changelog**: https://github.com/o/r/compare/v1.2.2...v1.2.3",
  "## What's Changed\n* Bump foo from 1.0.0 to 1.1.0 by @dependabot in https://github.com/o/r/pull/12",
  "### Patch Changes\n\n- Updated dependencies [abc1234]\n  - @scope/pkg@1.2.3",
  "## 1.0.0\n\nNo significant changes.",
  "## Features\n\n- Adds `after()` 🚀",
  "### Bug Fixes\n\n- **deps:** update dependency zod to v4.1.0 (#123)",
  "## Thank you\n\n- @someone\n- @other",
  "Initial release",
  "- chore: release v2.0.0",
  "Node.js 20 is now required.",
  "## ✨ Features\n\n- `defineConfig` accepts `env` ünïcödé",
  "<!-- comment -->\n| --- | --- |",
];
const locateCases = [
  { notes: "## Features ✨\n\n- Adds `after` to run work once a response finishes.", quote: "Adds after to run work" },
  { notes: "## A\n- one\n## B 🎉\n- **Two** things", quote: "two things" },
  { notes: "line one\nline two", quote: "one line two" },
  { notes: "nothing", quote: "absent" },
];

// ---- Whole extractions through a stubbed chat endpoint.
interface Exchange { prompt_sha256: string; body: unknown; content: string; finish: string }
let exchanges: Exchange[] = [];
let answer: (prompt: string) => { content: string; finish?: string } = () => ({ content: "[]" });
globalThis.fetch = (async (_url: string, init: { body: string }) => {
  const body = JSON.parse(init.body) as { messages: Array<{ content: string }> };
  const prompt = body.messages[0]!.content;
  const a = answer(prompt);
  exchanges.push({ prompt_sha256: sha256(prompt), body, content: a.content, finish: a.finish ?? "stop" });
  return new Response(JSON.stringify({ choices: [{ message: { content: a.content }, finish_reason: a.finish ?? "stop" }], usage: { prompt_tokens: 100, completion_tokens: 20 } }), { status: 200 });
}) as unknown as typeof fetch;

const REC = (o: Record<string, unknown>) => ({ subject_kind: null, facet: null, change_type: "new_api", surface: "code_api", audience: "application", introduces: [], ...o });
const labels = (n: number, f: (i: number) => Record<string, unknown>) => JSON.stringify(Object.fromEntries(Array.from({ length: n }, (_, i) => [`r${i + 1}`, f(i)])));

const tech = { id: "example", name: "Example.js", components: ["pkg:npm/example"] };
const NOTES = [
  "## Features ✨",
  "",
  "- Adds `defineConfig()` — a typed helper for `example.config.ts` (#12)",
  "- `server.port` default is now 4000 🚀",
  "",
  "## Breaking",
  "",
  "- Node.js 18 is no longer supported; Node.js 20.9 is required.",
  "- Removes the deprecated `legacyMode` option. Use `mode: \"strict\"` instead.",
].join("\n");
const firstAnswer = JSON.stringify([
  REC({ subject: "`defineConfig()`", summary: "Adds defineConfig, a typed helper for the config file.", introduces: ["defineConfig", "defineConfig"], evidence: "Adds `defineConfig()` — a typed helper for `example.config.ts`" }),
  REC({ subject: "server.port", facet: null, change_type: "default_change", surface: "configuration", summary: "The default port is now 4000.", evidence: "server.port default is now 4000" }),
  REC({ subject: "node runtime", subject_kind: "concept", change_type: "removal", surface: "runtime_internal", summary: "Node.js 18 is no longer supported and Node.js 20.9 is required; " + "word ".repeat(45), audience: "extension_author", evidence: "Node.js 18 is no longer supported" }),
  REC({ subject: "legacyMode", subject_kind: "literal", change_type: "removal", summary: "The deprecated legacyMode option is removed.", audience: "maintainer", evidence: "not in the notes at all" }),
  { subject: "", summary: "dropped: empty subject" },
  { subject: "bad audience", summary: "dropped", audience: "someone" },
]);
const labelAnswer = labels(4, (i) => ({
  terms: [`term${i}`, "`defineConfig`", "defineConfig", 42, "x".repeat(250)],
  replaces: i === 3 ? ["legacyMode", "legacyMode"] : [],
  requires: [],
  prerequisites: i === 2 ? [{ ecosystem: "NPM", name: "node", min: "20.9" }, { ecosystem: "npm", name: "node", min: "18" }, { ecosystem: "", name: "x" }] : [],
  conditions: i === 1 ? ["Only on Linux"] : [],
}));
const GUIDE = [
  "# Upgrading to v5",
  "",
  "## Config file renamed",
  "",
  "**Likelihood Of Impact: High**",
  "",
  "Rename `example.json` to `example.config.ts`.",
].join("\n");
const DOCS_MARKED = renderChange("https://example.dev/docs/server", "docs", [
  { path: ["Server", "port"], status: "changed" as const, hunks: "@@ -1,2 +1,2 @@\n The port to listen on.\n-Default: 3000.\n+Default: 4000.", added: 1, removed: 1 },
], { words: true });
const LONG = Array.from({ length: 470 }, (_, i) => `- Fix \`route${i}\` handling of trailing slashes in nested segments ✨.`).join("\n");

const note = (version: string, notes: string, over: Record<string, unknown> = {}) => ({
  technology: tech.id, tag: `v${version}`, version, date: "2026-10-01", url: `https://github.com/example/example/releases/tag/v${version}`, snapshot: `sha256:${sha256(notes)}`, notes, ...over,
});
type Case = { name: string; note: ReturnType<typeof note>; answer: (prompt: string) => { content: string; finish?: string } };
const isLabel = (p: string) => p.startsWith("You write search terms");
const cases: Case[] = [
  { name: "release-notes", note: note("2.1.0", NOTES, { noteDate: "2026-09-30", noLaterThan: "2.1.3" }), answer: (p) => ({ content: isLabel(p) ? labelAnswer : firstAnswer }) },
  { name: "upgrade-guide", note: note("5.0.0", GUIDE, { kind: "upgrade_guide", keyTag: "+guide.0123abcd" }), answer: (p) => ({ content: isLabel(p) ? labels(1, () => ({ terms: ["example.json"], replaces: ["example.json"] })) : JSON.stringify([REC({ subject: "example.json", change_type: "removal", surface: "file_convention", summary: "The config file is renamed.", introduces: ["example.config.ts"], evidence: "Rename `example.json` to `example.config.ts`." })]) }) },
  { name: "docs-marked", note: note("2.1.0", DOCS_MARKED, { kind: "docs", keyTag: "+docs.4567abcd" }), answer: (p) => ({ content: isLabel(p) ? "not json" : JSON.stringify([REC({ subject: "server.port", change_type: "default_change", surface: "configuration", summary: "The default port is now 4000.", evidence: "Default: [-3000.-]{+4000.+}" })]) }) },
  { name: "empty-answer", note: note("2.1.1", "## Fixes\n\n- Fixes a crash when the cache is empty."), answer: () => ({ content: "```json\n[]\n```" }) },
  { name: "content-free", note: note("2.1.2", "## v2.1.2\n\n**Full Changelog**: https://github.com/example/example/compare/v2.1.1...v2.1.2"), answer: () => ({ content: "[]" }) },
  // Over MAX_CHUNK: three parts; the first part's answer runs out of room, so it is split into pieces.
  {
    name: "multi-part-truncated",
    note: note("2.2.0", LONG),
    answer: (p) => {
      if (isLabel(p)) return { content: labels(1, () => ({ terms: ["route"] })) };
      if (p.includes("Part 1 of") && !p.includes("Piece ")) return { content: "[{\"subject\": \"rou", finish: "length" };
      const m = /`(route\d+)`/.exec(p.slice(p.indexOf("<notes>")));
      return { content: JSON.stringify([REC({ subject: m![1], change_type: "fix", summary: `Fixes ${m![1]}.`, evidence: `Fix \`${m![1]}\` handling of trailing slashes` })]) };
    },
  },
];

const extractions = [];
for (const c of cases) {
  exchanges = [];
  answer = c.answer;
  process.env.UNSTALE_CENTRAL_DIR = mkdtempSync(join(tmpdir(), "unstale-js-port-"));
  const out = await extractRelease(tech as never, c.note as never);
  const ev = { ...eventOf(tech, c.note as never), freshness: { first_seen: "2026-10-01T00:00:00.000Z", first_published: "2026-10-01T00:00:00.000Z" } };
  extractions.push({ name: c.name, event: ev, exchanges: [...exchanges].sort((a, b) => a.prompt_sha256.localeCompare(b.prompt_sha256)), incoming: out.incoming, failed: out.failed });
}

const fixtures = {
  min_split: MIN_SPLIT,
  chunk: chunkCases.map((c) => ({ ...c, out: chunk(c.notes, c.max) })),
  split: splitCases.map((notes) => ({ notes, out: splitChunk(notes) })),
  content_free: contentFreeCases.map((notes) => ({ notes, out: contentFree(notes) })),
  locate: locateCases.map((c) => ({ ...c, out: locate(c.notes, c.quote) })),
  extractions,
};
// Each JavaScript cut must be valid UTF-16, or the fixture could not be read as JSON text by the port.
const lone = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;
for (const s of [...fixtures.chunk.flatMap((c) => c.out), ...fixtures.split.flatMap((c) => c.out)]) if (lone.test(s)) throw new Error("a case cuts a surrogate pair");
writeFileSync(new URL("./fixtures.json", import.meta.url), JSON.stringify(fixtures, null, 1) + "\n");
console.log(`wrote ${extractions.length} extractions, ${exchanges.length} exchanges in the last`);
