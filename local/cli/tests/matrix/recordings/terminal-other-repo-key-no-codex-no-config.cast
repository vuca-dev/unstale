[1.66,"o","\r\n"]
[1.72,"o","Enter for 1, or 2:\r\n"]
[1.78,"o","\r\n"]
[1.84,"o","Add one of these lines to your shell profile or this repo's .env, then run `unstale setup`:\r\n"]
[1.9,"o","\r\n"]
[1.96,"o","  OPENAI_API_KEY=<key>      OpenAI\r\n"]
[2.02,"o","  AI_GATEWAY_API_KEY=<key>  Vercel AI Gateway\r\n"]
