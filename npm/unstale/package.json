{
  "name": "@unstale/cli",
  "version": "0.2.0",
  "description": "Tells Claude Code, Codex and Cursor what changed upstream since their training cutoff that applies to your code: new APIs to adopt, breaking changes for your next major upgrade, deprecations, and the security and performance fixes in each version bump.",
  "license": "AGPL-3.0-only",
  "author": "Jason Draper (https://vuca.dev)",
  "homepage": "https://unstale.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuca-dev/unstale.git",
    "directory": "npm/unstale"
  },
  "bugs": "https://github.com/vuca-dev/unstale/issues",
  "keywords": [
    "unstale",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "agent-skills",
    "knowledge-cutoff",
    "release-notes",
    "changelog",
    "upgrade",
    "migration",
    "breaking-changes",
    "deprecation",
    "security-advisories",
    "dependencies"
  ],
  "bin": {
    "unstale": "bin/unstale.js"
  },
  "files": ["bin/unstale.js"],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@unstale/cli-darwin-arm64": "0.2.0",
    "@unstale/cli-darwin-x64": "0.2.0",
    "@unstale/cli-linux-arm64": "0.2.0",
    "@unstale/cli-linux-x64": "0.2.0",
    "@unstale/cli-win32-x64": "0.2.0"
  }
}
