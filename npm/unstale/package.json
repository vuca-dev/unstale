    "bin/unstale.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@unstale/cli-darwin-arm64": "0.1.0",
    "@unstale/cli-darwin-x64": "0.1.0",
    "@unstale/cli-linux-arm64": "0.1.0",
    "@unstale/cli-linux-x64": "0.1.0",
    "@unstale/cli-win32-x64": "0.1.0"
  }
}
