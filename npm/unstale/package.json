{
  "name": "@unstale/cli",
  "version": "0.3.0",
  "description": "Dependency upgrade impact analysis for coding agents: finds the breaking changes that affect your code, security fixes, deprecations and new APIs, and tells Claude Code, Codex, Cursor or opencode what an upgrade means for your code. Local, cited, open source.",
  "license": "AGPL-3.0-only",
  "author": "Jason Draper (https://vuca.dev)",
  "homepage": "https://unstale.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuca-dev/unstale.git",
    "directory": "npm/unstale"
  },
  "bugs": "https://github.com/vuca-dev/unstale/issues",
  "keywords": [
    "unstale",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "agent-skills",
    "knowledge-cutoff",
    "release-notes",
    "changelog",
    "upgrade",
    "migration",
    "breaking-changes",
    "dependency-upgrade",
    "upgrade-impact-analysis",
    "dependency-updates",
    "opencode",
    "deprecation",
    "security-advisories",
    "dependencies"
  ],
  "bin": {
    "unstale": "bin/unstale.js"
  },
  "files": ["bin/unstale.js"],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@unstale/cli-darwin-arm64": "0.3.0",
    "@unstale/cli-darwin-x64": "0.3.0",
    "@unstale/cli-linux-arm64": "0.3.0",
    "@unstale/cli-linux-x64": "0.3.0",
    "@unstale/cli-win32-x64": "0.3.0"
  }
}
