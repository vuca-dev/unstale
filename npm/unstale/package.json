    "@unstale/cli-darwin-x64": "0.2.5",
    "@unstale/cli-linux-arm64": "0.2.5",
    "@unstale/cli-linux-x64": "0.2.5",
    "@unstale/cli-win32-x64": "0.2.5"
  }
}
