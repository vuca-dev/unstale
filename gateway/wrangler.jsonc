// The unstale Worker (src/index.ts). Static files: the exported catalog, passed at deploy time
// (`wrangler deploy --assets <export dir>`, ingest.yml). Secrets, set once with `wrangler secret put`:
// DRAIN_TOKEN (shared with ingest.yml as GATEWAY_DRAIN_TOKEN) and, for fast-track, GITHUB_DISPATCH_TOKEN.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unstale",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // The public address, compiled into release builds as UNSTALE_DEFAULT_SERVICE: keep it stable. The workers.dev
  // address stays on (UNSTALE_GATEWAY_URL may use either).
  // unstale.sh is the website (gateway/site/build.ts), served from the same static tree; www redirects to it.
  "routes": [
    { "pattern": "api.unstale.sh", "custom_domain": true },
    { "pattern": "unstale.sh", "custom_domain": true },
    { "pattern": "www.unstale.sh", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    // Site pages run the Worker first for the www/https redirects and Markdown for agents (src/index.ts, page).
    "run_worker_first": ["/health", "/coverage", "/internal/*", "/", "/npm/*", "/pypi/*", "/google*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "COVERAGE", "class_name": "Coverage" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coverage"] }],
  "vars": {
    "RATE_PER_HOUR": "20",
    "MAX_PENDING": "50000",
    // New packages held per UTC hour, all clients together (no addresses kept): bounds how fast the queue can fill.
    "NEW_PER_HOUR": "1000",
    // Coverage runs a new package may start at once per UTC day (0: wait for the schedule). The run works it only if
    // it is next in the line of new technologies (central drain --fast-track); admission and the coverage budget
    // still apply. Free on a public repository; a private one pays per runner minute.
    "FAST_TRACK_PER_DAY": "24",
    "FAST_TRACK_INTERVAL_MINUTES": "15",
    "GITHUB_REPOSITORY": "vuca-dev/unstale",
    "GITHUB_WORKFLOW": "ingest.yml",
    "GITHUB_REF": "main"
  }
}
